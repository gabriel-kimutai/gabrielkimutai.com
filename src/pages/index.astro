---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import Hero from "../components/home/Hero.astro";
import SelectedWork from "../components/home/SelectedWork.astro";
import Writing from "../components/home/Writing.astro";
import Engineering from "../components/home/Engineering.astro";
import Experience from "../components/home/Experience.astro";
import Closing from "../components/home/Closing.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.weight - b.data.weight,
);
const featured = projects.find((p) => p.data.featured) ?? projects[0];
const others = projects.filter((p) => p.id !== featured.id);

const writing = (await getCollection("writing").catch(() => []))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<PageLayout>
  <div class="home">
    <Hero />
    <SelectedWork featured={featured} others={others} />
    <Writing entries={writing} />
    <Engineering />
    <Experience />
    <Closing />
  </div>
</PageLayout>
