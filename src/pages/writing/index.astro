---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import SectionLabel from "../../components/SectionLabel.astro";

const published = (await getCollection("writing").catch(() => []))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout
  title="Writing"
  description="Notes on protocol design, systems, and the parts of a project that are still unfinished."
>
  <section class="page-hero">
    <div class="wrap page-hero__grid">
      <SectionLabel index="02" label="Writing" />
      <div>
        <h1>Writing</h1>
        <p class="lead muted">
          Notes on things I have built, including the decisions I am not sure
          about yet. Written while the reasoning is still fresh enough to be
          wrong.
        </p>
      </div>
    </div>
  </section>
  <section class="section section--flush">
    <div class="wrap">
      {
        published.length === 0 ? (
          <p class="muted">Nothing published yet.</p>
        ) : (
          <ol class="entry-list">
            {published.map((entry) => (
              <li class="entry">
                <a class="entry__link" href={`/writing/${entry.id}/`}>
                  <p class="meta entry__date">
                    <time datetime={entry.data.date.toISOString()}>
                      {entry.data.date.toLocaleDateString("en-GB", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                  </p>
                  <div class="entry__body">
                    <h2 class="entry__title">{entry.data.title}</h2>
                    <p class="entry__summary">{entry.data.description}</p>
                    {entry.data.tags.length > 0 && (
                      <ul class="tech-meta entry__tags">
                        {entry.data.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <span class="entry__cue meta" aria-hidden="true">
                    Read
                  </span>
                </a>
              </li>
            ))}
          </ol>
        )
      }

      <p class="muted writing-outro">
        The feed is at <a href="/rss.xml">/rss.xml</a> if you would rather not check
        back.
      </p>
    </div>
  </section>
</PageLayout>
