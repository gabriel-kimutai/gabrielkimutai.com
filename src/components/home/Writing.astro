---
import type { CollectionEntry } from "astro:content";
import SectionLabel from "../SectionLabel.astro";

interface Props {
  entries: CollectionEntry<"writing">[];
}

const { entries } = Astro.props;
---

<section class="section" id="writing" aria-labelledby="writing-heading">
  <div class="wrap">
    <div class="section-head">
      <SectionLabel index="02" label="Writing" />
      <div>
        <h2 id="writing-heading">Writing</h2>
        <p class="muted">
          Longer notes on what I have built and what I got wrong. Mostly
          protocol design at the moment.
        </p>
      </div>
    </div>
    {
      entries.length === 0 ? (
        <p class="muted">Nothing published yet.</p>
      ) : (
        <ol class="entry-list">
          {entries.map((entry) => (
            <li class="entry">
              <a class="entry__link" href={`/writing/${entry.id}/`}>
                <p class="meta entry__date">
                  <time datetime={entry.data.date.toISOString()}>
                    {entry.data.date.toLocaleDateString("en-GB", {
                      year: "numeric",
                      month: "short",
                    })}
                  </time>
                </p>
                <div class="entry__body">
                  <h3 class="entry__title">{entry.data.title}</h3>
                  <p class="entry__summary">{entry.data.description}</p>
                </div>
                <span class="entry__cue meta" aria-hidden="true">
                  Read
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
    <p class="section-more">
      <a class="more-link" href="/writing/">All writing →</a>
    </p>
  </div>
</section>
