---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"writing">[];
}

const { entries } = Astro.props;
---

<section class="wrap home-sec" id="writing" aria-labelledby="writing-heading">
  <div class="home-sechead">
    <h2 id="writing-heading">Writing</h2>
    <p>
      Longer notes on what I built and what went wrong, mostly about protocol
      design.
    </p>
  </div>
  {
    entries.length === 0 ? (
      <p class="muted">Nothing published yet.</p>
    ) : (
      <div class="rows">
        {entries.map((entry, i) => (
          <a class="row" href={`/writing/${entry.id}/`}>
            <span class="meta">{String(i + 1).padStart(2, "0")}</span>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <time
              class="meta row__date"
              datetime={entry.data.date.toISOString()}
            >
              {entry.data.date.toLocaleDateString("en-GB", {
                year: "numeric",
                month: "short",
              })}
            </time>
          </a>
        ))}
      </div>
    )
  }
  <a class="home-more" href="/writing/">All writing →</a>
</section>
