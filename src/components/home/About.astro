---
import SectionLabel from "../SectionLabel.astro";
---

<section class="section" id="about" aria-labelledby="about-heading">
  <div class="wrap split">
    <div>
      <SectionLabel index="05" label="About" />
      <h2 id="about-heading">About</h2>
    </div>
    <div>
      <p class="lead">
        I work on backend systems, Android applications, and the infrastructure
        that keeps services deployable and operable.
      </p>
      <p class="muted">
        Day to day that means Go and API work, React/TypeScript where a web
        client is needed, Android/Kotlin for mobile systems, and Linux/cloud
        tooling around delivery. I am particularly interested in networking and
        distributed systems — service discovery, realtime channels, and clear
        service boundaries.
      </p>
      <p style="margin-top: 1.25rem;">
        <a class="more-link" href="/about/">More about the work →</a>
      </p>
    </div>
  </div>
</section>
