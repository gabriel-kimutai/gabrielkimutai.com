---
import { site } from "../../site";
---

<section class="wrap home-sec" id="about" aria-labelledby="about-heading">
  <div class="about">
    <h2 id="about-heading">About</h2>
    <div class="about__body">
      <p class="about__lead">
        I prefer systems with explicit interfaces, clear boundaries, and
        failures that surface where they originate.
      </p>
      <p>
        Most of my work is in Go on the backend and Kotlin on Android, with
        React and TypeScript when the browser needs it, plus Linux, Docker and
        CI around all of it. I keep coming back to service discovery, realtime
        channels, and the question of what two programs are allowed to say to
        each other.
      </p>
      <a class="home-more" href="/about/">How I work →</a>
    </div>
  </div>
</section>

<section
  class="wrap home-sec contact"
  id="contact"
  aria-labelledby="contact-heading"
>
  <div class="contact__inner">
    <h2 id="contact-heading">Contact</h2>
    <p class="contact__note">Email is the best way to reach me.</p>
    <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="contact__links">
      <a class="btn" href={site.github} rel="noopener noreferrer">GitHub</a>
      <a class="btn" href={site.linkedin} rel="noopener noreferrer">LinkedIn</a>
    </div>
  </div>
</section>
