---
import SectionLabel from "../SectionLabel.astro";
---

<section class="section" id="experience" aria-labelledby="exp-heading">
  <div class="wrap">
    <div class="section-head">
      <SectionLabel index="03" label="Experience" />
      <div>
        <h2 id="exp-heading">Experience</h2>
        <p class="muted">A compact record. No invented metrics.</p>
      </div>
    </div>
    <ol class="timeline">
      <li>
        <p class="meta timeline__meta">Aug 2025 – Present · Nairobi, Kenya</p>
        <h3>Full-stack Developer — Innovative Tech Labs</h3>
        <ul>
          <li>AWS migration</li>
          <li>CI/CD automation</li>
          <li>Event management systems</li>
          <li>Customer-facing applications</li>
          <li>Payment and loyalty integrations</li>
        </ul>
      </li>
      <li>
        <p class="meta timeline__meta">Sep 2024 – Aug 2025 · Nairobi, Kenya</p>
        <h3>Full-stack Developer — Pakua</h3>
        <ul>
          <li>Go APIs</li>
          <li>Real-time C2C messaging</li>
          <li>WebSockets</li>
          <li>Inventory systems</li>
        </ul>
      </li>
    </ol>
  </div>
</section>
