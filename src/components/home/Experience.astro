---

interface Experience {
  title: {
    role: string;
    company: string;
  };
  timeline: {
    from: Date | string;
    to: Date | string;
  };
  location: {
    city: string;
    country: string;
  };
  activities: string[];
}

const items: Experience[] = [
  {
    title: {
      role: "Full-stack Developer",
      company: "Innovative Tech Labs",
    },
    timeline: {
      from: "Aug 2025",
      to: "Present",
    },
    location: {
      city: "Nairobi",
      country: "Kenya",
    },
    activities: [
      "AWS migration",
      "CI/CD automation",
      "Event management systems",
      "Customer-facing applications",
      "Payment and loyalty integrations",
    ],
  },
  {
    title: {
      role: "Full-stack Developer",
      company: "Pakua",
    },
    timeline: {
      from: "Sep 2024",
      to: "Aug 2025",
    },
    location: {
      city: "Nairobi",
      country: "Kenya",
    },
    activities: [
      "Go APIs",
      "Real-time C2C messaging",
      "Websockets",
      "Inventory systems",
    ],
  },
];
---

<section class="wrap home-sec" id="experience" aria-labelledby="exp-heading">
  <div class="home-sechead">
    <h2 id="exp-heading">Experience</h2>
    <span></span>
  </div>
  <div class="rows">
    {
      items.map((item, i) => (
        <div class="row">
          <span class="meta">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h3>{item.title.role}</h3>
            <p class="row__sub">
              {item.title.company} · {item.location.city}
            </p>
          </div>
          <p>{item.activities.join(", ")}.</p>
          <span class="meta row__date">
            {item.timeline.from} –{" "}
            {item.timeline.to === "Present" ? "Now" : item.timeline.to}
          </span>
        </div>
      ))
    }
  </div>
</section>
