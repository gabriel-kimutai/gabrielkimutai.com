---
const areas = [
  {
    index: "Backend",
    items: ["Go", "PostgreSQL", "APIs", "Event-driven systems"],
    note: "Pakua, event and payment systems",
  },
  {
    index: "Networking",
    items: ["UDP", "mDNS", "WebSockets", "SSE", "Service discovery"],
    note: "Heimdall, marketplace and event systems",
  },
  {
    index: "Mobile",
    items: ["Android", "Kotlin", "Jetpack Compose"],
    note: "Heimdall, Plutus",
  },
  {
    index: "Infrastructure",
    items: ["Linux", "Docker", "AWS", "CI/CD", "Observability"],
    note: "AWS migration, CI/CD automation, Linux and systemd packaging",
  },
];
---

<section class="wrap home-sec" id="engineering" aria-labelledby="eng-heading">
  <div class="home-sechead">
    <h2 id="eng-heading">Engineering</h2>
    <p>The tools I reach for, each tied to a system I've actually shipped.</p>
  </div>
  <div class="eng">
    {
      areas.map((area) => (
        <article>
          <span class="meta">{area.index}</span>
          <h3 class="visually-hidden">{area.index}</h3>
          <ul aria-label={`${area.index} tools`}>
            {area.items.map((item) => (
              <li class="eng__item">{item}</li>
            ))}
          </ul>
          <p>{area.note}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .eng__item {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.875rem;
    line-height: 2rem;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
