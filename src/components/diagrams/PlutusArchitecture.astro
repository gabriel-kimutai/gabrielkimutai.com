---
import TechnicalDiagram from "../TechnicalDiagram.astro";
---

<TechnicalDiagram
  caption="Fig. 07 — On-device ingestion, persistence, and background work"
>
  <svg viewBox="0 0 520 360" role="img" aria-labelledby="plutus-arch-title">
    <title id="plutus-arch-title">
      Notification feed is parsed, stored in Room, then rendered in Compose and
      processed in the background with WorkManager.
    </title>
    <g fill="none" stroke="#c97a3a" stroke-width="1.2">
      <rect x="120" y="16" width="280" height="48"></rect>
      <rect x="120" y="100" width="280" height="48"></rect>
      <rect x="120" y="184" width="280" height="48"></rect>
      <rect x="24" y="288" width="200" height="48"></rect>
      <rect x="296" y="288" width="200" height="48"></rect>
    </g>
    <g
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="11"
      fill="#ece6d9"
    >
      <text x="176" y="44">NOTIFICATION FEED</text>
      <text x="176" y="128">PARSING PIPELINE</text>
      <text x="164" y="212">LOCAL MODEL / ROOM</text>
      <text x="84" y="316">COMPOSE UI</text>
      <text x="324" y="316">WORKMANAGER</text>
    </g>
    <g stroke="#c97a3a" fill="none" stroke-width="1">
      <path d="M260 64 V100"></path>
      <path d="M260 148 V184"></path>
      <path d="M200 232 V288"></path>
      <path d="M320 232 V260 H396 V288"></path>
    </g>
  </svg>
</TechnicalDiagram>
