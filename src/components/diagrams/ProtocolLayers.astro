---
import TechnicalDiagram from "../TechnicalDiagram.astro";

const layers = [
  {
    name: "TRANSPORT",
    note: "TCP. A byte stream with no message boundaries.",
    state: "given",
  },
  {
    name: "FRAME I/O",
    note: "ReadFrame / WriteFrame. Survives partial reads and writes.",
    state: "built",
  },
  {
    name: "FRAME",
    note: "18-byte header. Validation and serialization.",
    state: "built",
  },
  {
    name: "MESSAGE",
    note: "Type, flags, request correlation.",
    state: "partial",
  },
  {
    name: "PAYLOAD CODEC",
    note: "Undefined. This is where a compiler goes.",
    state: "open",
  },
  {
    name: "SERVICE",
    note: "System, process, power.",
    state: "open",
  },
];

const boxHeight = 34;
const gap = 14;
const top = 26;

const strokeFor = (state: string) =>
  state === "built" ? "#f2f2f2" : state === "partial" ? "#a8a8a8" : "#6b6b6b";
---

<TechnicalDiagram
  caption="Fig. 07 — Protocol layers. Solid: implemented. Faint: specified or deferred."
  bleed
  scroll
>
  <svg viewBox="0 0 640 314" role="img" aria-labelledby="protocol-layers-title">
    <title id="protocol-layers-title">
      The Heimdall protocol stack from transport up to service. The transport is
      a byte stream, the frame I/O and frame layers are implemented, the message
      layer is partly implemented, and the payload codec and service layers are
      still open.
    </title>
    {
      layers.map((layer, i) => {
        const y = top + i * (boxHeight + gap);
        const stroke = strokeFor(layer.state);
        return (
          <g>
            <rect
              x="24"
              y={y}
              width="220"
              height={boxHeight}
              fill="none"
              stroke={stroke}
              stroke-width="1.2"
              stroke-dasharray={layer.state === "built" ? undefined : "3 3"}
            />
            <text
              x="40"
              y={y + 21}
              font-family="IBM Plex Mono, ui-monospace, monospace"
              font-size="11"
              fill={layer.state === "built" ? "#f2f2f2" : "#a8a8a8"}
            >
              {layer.name}
            </text>
            <text
              x="272"
              y={y + 21}
              font-family="IBM Plex Mono, ui-monospace, monospace"
              font-size="10.5"
              fill={layer.state === "open" ? "#8c8c8c" : "#a8a8a8"}
            >
              {layer.note}
            </text>
            {i < layers.length - 1 && (
              <path
                d={`M134 ${y + boxHeight} V ${y + boxHeight + gap}`}
                stroke={strokeFor(layers[i + 1].state)}
                stroke-width="1"
                fill="none"
              />
            )}
          </g>
        );
      })
    }
  </svg>
</TechnicalDiagram>
