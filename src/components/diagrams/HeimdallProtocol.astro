---
import TechnicalDiagram from "../TechnicalDiagram.astro";
---

<TechnicalDiagram
  caption="Fig. 04 — Request/response plus streamed events"
  scroll
>
  <svg viewBox="0 0 640 220" role="img" aria-labelledby="heimdall-proto-title">
    <title id="heimdall-proto-title">
      Bidirectional session: the client sends requests, the daemon returns
      responses and can publish events such as system.stats.
    </title>
    <g fill="none" stroke="#f2f2f2" stroke-width="1.2">
      <rect x="40" y="70" width="150" height="70"></rect>
      <rect x="450" y="70" width="150" height="70"></rect>
    </g>
    <g
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="11"
      fill="#f2f2f2"
    >
      <text x="68" y="100">ANDROID</text>
      <text x="68" y="116" fill="#a8a8a8">client</text>
      <text x="482" y="100">DAEMON</text>
      <text x="482" y="116" fill="#a8a8a8">host</text>
      <text x="228" y="52" fill="#f2f2f2">request →</text>
      <text x="228" y="92" fill="#f2f2f2">← response</text>
      <text x="228" y="148" fill="#f2f2f2">← event</text>
    </g>
    <g stroke="#f2f2f2" fill="none" stroke-width="1">
      <path d="M190 88 H450"></path>
      <path d="M450 108 H190"></path>
      <path d="M450 128 H190"></path>
    </g>
  </svg>
</TechnicalDiagram>
