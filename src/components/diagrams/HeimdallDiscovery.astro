---
import TechnicalDiagram from "../TechnicalDiagram.astro";
---

<TechnicalDiagram caption="Fig. 03 — Discovery is separate from control">
  <svg viewBox="0 0 760 280" role="img" aria-labelledby="heimdall-disc-title">
    <title id="heimdall-disc-title">
      The Android client queries the local network. Hosts running the Heimdall
      daemon advertise themselves; other devices are ignored.
    </title>
    <g fill="none" stroke="#c97a3a" stroke-width="1.2">
      <rect x="300" y="16" width="160" height="44"></rect>
      <rect x="300" y="108" width="160" height="44"></rect>
      <rect x="48" y="204" width="140" height="48"></rect>
      <rect x="310" y="204" width="140" height="48"></rect>
      <rect x="572" y="204" width="140" height="48"></rect>
    </g>
    <g
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="11"
      fill="#ece6d9"
    >
      <text x="336" y="42">ANDROID</text>
      <text x="324" y="134">LOCAL NETWORK</text>
      <text x="72" y="224">HOST A</text>
      <text x="72" y="240" fill="#8f887b">+ daemon</text>
      <text x="334" y="224">HOST B</text>
      <text x="334" y="240" fill="#8f887b">+ daemon</text>
      <text x="600" y="224">OTHER</text>
      <text x="600" y="240" fill="#8f887b">devices</text>
    </g>
    <g stroke="#c97a3a" fill="none" stroke-width="1">
      <path d="M380 60 V108"></path>
      <path d="M380 152 V180"></path>
      <path d="M118 180 H642"></path>
      <path d="M118 180 V204"></path>
      <path d="M380 180 V204"></path>
      <path d="M642 180 V204"></path>
    </g>
    <g
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="9"
      fill="#c97a3a"
    >
      <text x="392" y="88">discovery query</text>
    </g>
  </svg>
</TechnicalDiagram>
