---
import TechnicalDiagram from "../TechnicalDiagram.astro";
---

<TechnicalDiagram caption="Fig. 02 — Client, protocol, and host capabilities">
  <svg viewBox="0 0 760 300" role="img" aria-labelledby="heimdall-arch-title">
    <title id="heimdall-arch-title">
      Android client talks to the Heimdall daemon over an authenticated protocol
      after mDNS discovery. The daemon owns system, process, network, security,
      and power operations.
    </title>
    <defs>
      <marker
        id="a2"
        markerWidth="8"
        markerHeight="8"
        refX="6"
        refY="4"
        orient="auto"
      >
        <path d="M0 0 L8 4 L0 8" fill="none" stroke="#c97a3a" stroke-width="1.2"
        ></path>
      </marker>
    </defs>
    <g fill="none" stroke="#c97a3a" stroke-width="1.2">
      <rect x="24" y="88" width="170" height="70"></rect>
      <rect x="294" y="80" width="176" height="86"></rect>
      <rect x="576" y="24" width="150" height="40"></rect>
      <rect x="576" y="78" width="150" height="40"></rect>
      <rect x="576" y="132" width="150" height="40"></rect>
      <rect x="576" y="186" width="150" height="40"></rect>
      <rect x="576" y="240" width="150" height="40"></rect>
    </g>
    <g
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="11"
      fill="#ece6d9"
    >
      <text x="46" y="118">ANDROID CLIENT</text>
      <text x="46" y="136" fill="#8f887b">Kotlin</text>
      <text x="318" y="116">HEIMDALL DAEMON</text>
      <text x="318" y="134" fill="#8f887b">Go · Linux</text>
      <text x="598" y="48">system</text>
      <text x="598" y="102">process</text>
      <text x="598" y="156">network</text>
      <text x="598" y="210">security</text>
      <text x="598" y="264">power</text>
    </g>
    <g stroke="#c97a3a" fill="none" stroke-width="1" marker-end="url(#a2)">
      <path d="M194 123 H294"></path>
      <path d="M470 123 H576"></path>
      <path d="M520 123 V98 H576"></path>
      <path d="M520 123 V152 H576"></path>
      <path d="M520 123 V206 H576"></path>
      <path d="M520 123 V260 H576"></path>
    </g>
    <g
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="9"
      fill="#c97a3a"
    >
      <text x="198" y="112">mDNS</text>
      <text x="198" y="148">authenticated protocol</text>
    </g>
  </svg>
</TechnicalDiagram>
