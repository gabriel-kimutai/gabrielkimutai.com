---
import TechnicalDiagram from "../TechnicalDiagram.astro";

const stages = ["LEX", "PARSE", "CHECK", "EMIT"];
---

<TechnicalDiagram
  caption="Fig. 09 — Intended shape. One schema, two generated codecs. Only the schema file exists."
  bleed
  scroll
>
  <svg viewBox="0 0 640 210" role="img" aria-labelledby="codegen-fanout-title">
    <title id="codegen-fanout-title">
      A single schema file passes through the heimdallc stages of lexing,
      parsing, checking, and emitting, producing a Go codec for the daemon and a
      Kotlin codec for the Android client.
    </title>

    <rect
      x="16"
      y="78"
      width="120"
      height="54"
      fill="none"
      stroke="#f2f2f2"
      stroke-width="1.2"></rect>
    <text
      x="76"
      y="100"
      text-anchor="middle"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="10.5"
      fill="#f2f2f2">sysinfo.hmd</text
    >
    <text
      x="76"
      y="116"
      text-anchor="middle"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="9.5"
      fill="#8c8c8c">schema</text
    >

    <path d="M136 105 H196" stroke="#6b6b6b" stroke-width="1" fill="none"
    ></path>
    <path
      d="M190 101 L196 105 L190 109"
      stroke="#6b6b6b"
      stroke-width="1"
      fill="none"></path>

    <rect
      x="196"
      y="56"
      width="228"
      height="98"
      fill="none"
      stroke="#6b6b6b"
      stroke-width="1.2"
      stroke-dasharray="3 3"></rect>
    <text
      x="210"
      y="76"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="10.5"
      fill="#a8a8a8">HEIMDALLC</text
    >

    {
      stages.map((stage, i) => (
        <g>
          <rect
            x={210 + i * 51}
            y={96}
            width="44"
            height="30"
            fill="none"
            stroke="#6b6b6b"
            stroke-width="1"
            stroke-dasharray="2 3"
          />
          <text
            x={232 + i * 51}
            y={115}
            text-anchor="middle"
            font-family="IBM Plex Mono, ui-monospace, monospace"
            font-size="9"
            fill="#8c8c8c"
          >
            {stage}
          </text>
          {i < stages.length - 1 && (
            <path
              d={`M${254 + i * 51} 111 H ${261 + i * 51}`}
              stroke="#6b6b6b"
              stroke-width="1"
              fill="none"
            />
          )}
        </g>
      ))
    }

    <path
      d="M424 105 H452 V 78 H484"
      stroke="#6b6b6b"
      stroke-width="1"
      fill="none"></path>
    <path
      d="M424 105 H452 V 134 H484"
      stroke="#6b6b6b"
      stroke-width="1"
      fill="none"></path>

    <rect
      x="484"
      y="56"
      width="140"
      height="44"
      fill="none"
      stroke="#6b6b6b"
      stroke-width="1.2"
      stroke-dasharray="3 3"></rect>
    <text
      x="500"
      y="74"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="10.5"
      fill="#a8a8a8">GO CODEC</text
    >
    <text
      x="500"
      y="89"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="9.5"
      fill="#8c8c8c">daemon</text
    >

    <rect
      x="484"
      y="112"
      width="140"
      height="44"
      fill="none"
      stroke="#6b6b6b"
      stroke-width="1.2"
      stroke-dasharray="3 3"></rect>
    <text
      x="500"
      y="130"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="10.5"
      fill="#a8a8a8">KOTLIN CODEC</text
    >
    <text
      x="500"
      y="145"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="9.5"
      fill="#8c8c8c">android client</text
    >

    <text
      x="16"
      y="186"
      font-family="IBM Plex Mono, ui-monospace, monospace"
      font-size="10"
      fill="#8c8c8c">SOLID: EXISTS · DASHED: DOES NOT</text
    >
  </svg>
</TechnicalDiagram>
